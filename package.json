{
  "name": "dark-devotion-map",
  "version": "0.4.112",
  "description": "An unofficial interactive map for Dark Devotion.",
  "author": "Aleksandr Podlesnyi",
  "license": "SEE LICENSE IN LICENSE.md",
  "keywords": [
    "dark-devotion",
    "interactive-map",
    "game-map",
    "leaflet",
    "react",
    "typescript",
    "vite"
  ],
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^24.18.0"
  },
  "scripts": {
    "dev": "vite --port 3001",
    "build": "tsc -b && vite build",
    "healthcheck": "react-compiler-healthcheck",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:summary": "vitest run --coverage.enabled --coverage.reporter=json-summary",
    "lint": "biome check",
    "lint:styles": "stylelint \"**/*.{css,scss}\"",
    "preview": "vite preview --port 3001"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/leaflet": "1.9.17",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.2",
    "oxc-transform-react": "0.145.0",
    "postcss": "8.5.29",
    "react-compiler-healthcheck": "1.0.0",
    "sass": "1.105.1",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.1"
  }
}
